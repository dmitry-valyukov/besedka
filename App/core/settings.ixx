// Настройки Беседки: то, чем она открывается.
//
// В файле место окна и доля границы между страницами -- и это не заготовка
// на будущее, а всё, что у приложения сейчас есть своего. Хранилище тем,
// форумов и прочитанного будет отдельным и большим; настройки же обязаны
// быть маленькими и читаться до первого кадра, потому что окно надо поставить
// туда, где его оставили, ещё до того, как оно покажется.
//
// Формат -- XML, разбираемый wxl::xml: читатель у нас уже есть, он проверяет
// документ целиком до разбора и берёт память из STA-пула, который создаётся
// всё равно. Запись своя, в двадцать строк, потому что формат наш.
//
// Разбор и запись отделены от файла -- parseSettings и formatSettings ходят
// строками, -- чтобы проверяться тестом, не трогая %LOCALAPPDATA%.
//
// Битый файл, файл от будущей версии, файл, который правили руками, -- всё
// это повод открыться со значениями по умолчанию, а не повод не открыться.

export module besedka.app:settings;

import std;

export namespace besedka::app {

/// Всё, что лежит в settings.xml.
struct Settings {
    /// Версия формата. Незнакомое поле не роняет разбор -- это она и покупает.
    static constexpr int kVersion = 1;

    /// Где стояло окно и в каком было состоянии. Текст непрозрачный: его
    /// выдаёт и принимает обратно окно wxl (`placement()`), а приложению
    /// достаточно донести его от файла до окна и обратно.
    std::wstring windowPlacement;

    /// Где стоит граница между страницами в двухстраничном показе: доля
    /// левой, 0,2…0,8. Доля, а не пиксели, потому что окно растягивают и
    /// переносят на другой монитор, и число пикселей на каждом из них
    /// означало бы разное.
    double splitFraction = 0.5;

    /// Масштаб списков и сообщений: 1 -- как есть. Читатель выбирает его
    /// раз под свои глаза и монитор, и переспрашивать при каждом запуске
    /// незачем.
    double zoom = 1.0;
};

/// Настройки из текста settings.xml. Любая беда -- умолчания.
Settings parseSettings(std::string xml);

/// Текст settings.xml. Локали у записи нет: в файле точка, что бы ни стояло
/// в Windows.
std::string formatSettings(const Settings& settings);

/// Каталог данных: `%LOCALAPPDATA%\Besedka`.
///
/// Не Roaming: место окна привязано к монитору этой машины, и переносить его
/// на другую было бы не услугой, а сюрпризом.
std::filesystem::path dataDirectory();

/// Путь к settings.xml.
std::filesystem::path settingsPath();

/// Читает settings.xml. Нет файла, битый файл -- вернутся умолчания.
Settings loadSettings();

/// Пишет settings.xml целиком: временный файл рядом, сброс на носитель,
/// потом замена. Сброс до переименования -- не педантизм: без него выключение
/// питания оставило бы переименование сделанным, а содержимое -- нет.
void saveSettings(const Settings& settings);

}  // namespace besedka::app
