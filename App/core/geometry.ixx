// Окно под картинку: сколько места дать заставке, чтобы её было видно
// целиком и как можно крупнее.

export module besedka.app:geometry;

export namespace besedka::app {

/// Размер в пикселях -- клиентской области или картинки.
struct Extent {
    int width = 0;
    int height = 0;

    bool operator==(const Extent&) const = default;
};

/// Клиентская область под картинку: пропорции картинки, во всю рабочую
/// область по высоте -- это и есть «максимально», выше только полноэкранный
/// режим, -- а если картинка шире экрана, то по ширине.
///
/// Считается именно клиентская: картинка живёт в ней, а не в окне, и окно
/// пропорций картинки показало бы её кадрированной ровно на рамку.
Extent fitToPicture(Extent room, Extent picture) noexcept;

}  // namespace besedka::app
