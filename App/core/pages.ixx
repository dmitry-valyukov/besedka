// Показ истории на экране: сколько страниц видно разом и что сделать с
// деревом, чтобы видно было именно их.
//
// История от ширины окна не зависит; ширина решает одно -- сколько последних
// её записей стоит на экране, одна или две. Правила целиком -- в
// docs/decisions.md, раздел про две страницы.
//
// План перемены дерева считается здесь, а не у самого дерева, и это не
// вопрос вкуса: именно там была ошибка, ронявшая приложение. Функция,
// ставившая «страницу в слот», при переезде правой страницы налево клала её
// в коллекцию вторым экземпляром -- элемент с живым родителем. План говорит
// ровно то, что дереву нужно: кто уходит, кто приходит, у кого какая
// сторона. Кто остаётся, того не трогают -- и щёлкнутая страница, чьё
// поддерево XAML в этот момент разбирает, остаётся на месте.

export module besedka.app:pages;

import std;
import :route;

export namespace besedka::app {

/// Порог двухстраничного показа -- в логических пикселях, а не в
/// физических: вопрос, на который он отвечает, это «хватает ли места на две
/// страницы текста», а текст меряется в логических. Разбор и происхождение
/// числа -- в docs/decisions.md.
inline constexpr double kTwoPageWidth = 1200;

/// Хватает ли ширины на две страницы.
bool isWide(double logicalWidth) noexcept;

/// Сколько страниц видно при такой ширине: одна или две.
std::size_t pagesShown(double logicalWidth) noexcept;

/// Что сделать с деревом, чтобы вместо того, что в нём стоит, стояло
/// нужное.
struct PagePlan {
    /// Показанная страница: какая и как в ней выбирают.
    struct Slot {
        Screen screen;

        /// Справа. Там читают, и выбирают там двойным щелчком: одиночный
        /// принадлежит содержимому.
        bool secondary;
    };

    std::vector<Screen> leaving;   ///< снять с дерева
    std::vector<Screen> entering;  ///< поставить в дерево

    /// Все показанные, слева направо -- и те, что стояли, и те, что пришли.
    std::vector<Slot> shown;
};

/// `inTree` -- экраны, стоящие в дереве сейчас; порядок роли не играет, место
/// в сетке задаёт колонка, а не номер в коллекции. `wanted` -- записи
/// истории, которые должны быть видны, слева направо: одна или две, и у двух
/// экраны разные (см. Screen).
PagePlan planPages(std::span<const Screen> inTree, std::span<const Route> wanted);

/// Пределы доли левой страницы: за ними у одной из страниц остаётся полоса, в
/// которой не помещается ни строка текста, ни заголовок.
inline constexpr double kSplitLower = 0.2;
inline constexpr double kSplitUpper = 0.8;

/// Доля, приведённая к пределам.
double clampedSplit(double fraction) noexcept;

}  // namespace besedka::app
