// besedka.app -- приложение без окон: то, что Беседка решает, отдельно от
// того, что она рисует.
//
// Здесь нет ни XAML, ни окна, ни сети -- только std, модель форума и текст с
// настройками из wxl. Поэтому всё здесь проверяется тестами (App/tests), а
// экранам и каркасу в App/src остаётся применять посчитанное: они -- вид, а
// не место, где принимаются решения.
//
// Партиции, снизу вверх:
//
//  - :route    -- куда можно прийти: маршрут, его экран, вкладка, подпись;
//  - :history  -- история переходов: назад, вперёд, хвост под показ;
//  - :pages    -- показ истории: сколько страниц видно и что для этого сделать
//                 с деревом;
//  - :settings -- settings.xml: разбор, запись, где лежит;
//  - :format   -- даты и отказы словами;
//  - :lists    -- что показывают списки: группы витрины, глубины ответов;
//  - :geometry -- окно под картинку заставки.
//
// Как это устроено целиком -- .claude/architecture.md.

export module besedka.app;

export import :route;
export import :history;
export import :pages;
export import :settings;
export import :format;
export import :lists;
export import :geometry;
