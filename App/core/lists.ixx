// Что показывают списки, посчитанное до всякого XAML: витрина по группам в
// порядке сервера и глубина каждого ответа в теме. Экрану остаётся пройти по
// готовому и построить строки.

export module besedka.app:lists;

import std;
import besedka.forum;

export namespace besedka::app {

/// Группа витрины и номера её форумов в исходном списке.
struct ShowcaseGroup {
    forum::ForumGroup group;
    std::vector<std::size_t> forums;
};

/// Группы в том порядке, который назначил им сервер: sortOrder для того и
/// прислан. Внутри группы порядок оставлен как есть -- сервер отдаёт форумы
/// по возрастанию идентификатора, то есть в порядке появления, и старожилы
/// форума знают их в этом порядке.
std::vector<ShowcaseGroup> groupShowcase(std::span<const forum::ForumDescription> forums);

/// Глубина каждого сообщения страницы, в порядке страницы: длина цепочки
/// родителей внутри неё. Сервер отдаёт сообщения в порядке появления, поэтому
/// родитель уже посчитан к тому времени, как доходит очередь до ребёнка;
/// сообщение, чьего родителя на странице нет, стоит на нулевой глубине.
std::vector<int> replyDepths(const forum::MessagePage& page);

}  // namespace besedka::app
