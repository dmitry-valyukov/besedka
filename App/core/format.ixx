// Словами на экран: даты так, как их читают, и отказ сервера так, как его
// можно показать.
//
// Часовой пояс приходит параметром, а не берётся из системы внутри: так
// тест строит моменты в том же поясе, в каком их потом читает, и не зависит
// от того, где стоит машина. Приложение отдаёт сюда current_zone().

export module besedka.app:format;

import std;

export namespace besedka::app {

/// Дата так, как её читают в списке тем: время сервера в UTC, а человек
/// живёт в своём поясе.
///
/// Подробность зависит от давности, как в jana (ui/utils/DateUtils.kt):
/// сегодняшнее сообщение -- одно время, этого года -- день с месяцем,
/// прошлогоднее -- одна дата. Число, повторяющее сегодняшнее у каждой из
/// полусотни строк, ничего не говорит; час говорит. Нулевой момент -- так
/// разбор отвечает на непрочитанную дату -- даёт пустую строку.
std::wstring relativeDate(std::chrono::system_clock::time_point moment,
                          std::chrono::system_clock::time_point now,
                          const std::chrono::time_zone& zone);

/// Дата у сообщения: полная, «10.09.2026 15:04». Нулевой момент -- пусто.
std::wstring fullDate(std::chrono::system_clock::time_point moment,
                      const std::chrono::time_zone& zone);

/// Отказ словами, которые можно показать. Транспорт называет причину сам
/// (сеть, сертификат, код ответа); всё прочее -- редкость, и о ней честнее
/// сказать «не вышло», чем выдумывать объяснение.
std::wstring reasonOf(const std::exception_ptr& why);

}  // namespace besedka::app
