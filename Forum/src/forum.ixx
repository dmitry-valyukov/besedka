// besedka::forum -- всё, что касается сервера RSDN: дорога до него, разбор
// ответов и модель, в которую они превращаются. Об интерфейсе этот модуль
// не знает и знать не будет.
//
// Четыре части, снизу вверх:
//
//  - :model -- предметные структуры. Ни сети, ни JSON;
//  - :transport -- HTTPS поверх Windows.Web.Http; ответ будущим;
//  - :parse -- дерево wxl::json -> модель;
//  - :api -- адреса запросов RSDN и склейка первых трёх.
//
// Устройство обмена взято у jana (`M:\source\jana`), официального клиента
// на Kotlin; показ сообщения не взят вовсе, потому что там он идёт через
// серверный HTML -- см. docs/decisions.md.
//
// Что обязан соблюдать вызывающий:
//
//  - wxl::core::sta_memory_pool должен быть создан один раз и пережить
//    последний разбор: оттуда идёт вся память дерева JSON;
//  - запрос через Api задаётся с потока этого пула -- туда же C++/WinRT
//    вернёт ответ, и там же он превратится в модель. Байты (:transport)
//    можно возить по потокам свободно, дерево -- нет;
//  - winrt::init_apartment() до первого запроса: HttpClient -- объект
//    WinRT.

export module besedka.forum;

export import :model;
export import :transport;
export import :parse;
export import :api;
