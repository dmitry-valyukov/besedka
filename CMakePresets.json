{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 5,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "warnings": {
        "dev": false
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:DebugDLL>"
      }
    },
    {
      "name": "x64",
      "displayName": "x64 (Ninja Multi-Config), wxl из пакета WinXL",
      "description": "wxl из пакета NuGet WinXL: поставщик cmake/winxl-provider.cmake восстанавливает его по nuget.config и packages.lock.json.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/winxl-provider.cmake",
        "BESEDKA_WXL_ROOT": ""
      }
    },
    {
      "name": "x64-wxl-tree",
      "displayName": "x64 (Ninja Multi-Config), wxl из соседнего дерева",
      "description": "wxl из соседнего дерева BESEDKA_WXL_ROOT (по умолчанию ../wxl), подключённого подкаталогом: сборка с невлитой парной веткой wxl. Пресет задаёт только умолчание BESEDKA_WXL_ROOT_DEFAULT, поэтому путь, однажды записанный в кэш, перенастройка сохраняет.",
      "inherits": "base",
      "cacheVariables": {
        "BESEDKA_WXL_ROOT_DEFAULT": "${sourceDir}/../wxl"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "configurePreset": "x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "configurePreset": "x64",
      "configuration": "Release"
    },
    {
      "name": "x64-wxl-tree-debug",
      "displayName": "x64 Debug, соседнее дерево wxl",
      "configurePreset": "x64-wxl-tree",
      "configuration": "Debug"
    },
    {
      "name": "x64-wxl-tree-release",
      "displayName": "x64 Release, соседнее дерево wxl",
      "configurePreset": "x64-wxl-tree",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "configurePreset": "x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-wxl-tree-debug",
      "displayName": "x64 Debug, соседнее дерево wxl",
      "configurePreset": "x64-wxl-tree",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-wxl-tree-release",
      "displayName": "x64 Release, соседнее дерево wxl",
      "configurePreset": "x64-wxl-tree",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
